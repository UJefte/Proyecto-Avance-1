        {
          "name": "Pase de visita (un solo uso)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pases/visita",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pases",
                "visita"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreVisitante\": \"Carlos Ruiz\",\n  \"correoVisitante\": \"carlos@correo.com\",\n  \"tipo\": \"VISITA\",\n  \"residenteId\": {{residenteId}},\n  \"vigenteDesde\": \"{{desde}}\",\n  \"vigenteHasta\": \"{{hasta}}\",\n  \"usosMaximos\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// fechas en hora local: desde hace 1 hora hasta dentro de 8 horas",
                  "const p = n => String(n).padStart(2, \"0\");",
                  "const local = d => d.getFullYear() + \"-\" + p(d.getMonth() + 1) + \"-\" + p(d.getDate()) + \"T\" + p(d.getHours()) + \":\" + p(d.getMinutes()) + \":\" + p(d.getSeconds());",
                  "const ahora = new Date();",
                  "pm.collectionVariables.set(\"desde\", local(new Date(ahora.getTime() - 3600000)));",
                  "pm.collectionVariables.set(\"hasta\", local(new Date(ahora.getTime() + 8 * 3600000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"codigoVisita\", r.codigo);",
                  "pm.test(\"Un solo uso\", () => pm.expect(r.usosMaximos).to.eql(1));"
                ]
              }
            }
          ]
        },
